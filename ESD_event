#tcl

# 1. Setup Design Environment
# Load the design database (DEF/LEF or GDS/OASIS)
open_design -design_file my_chip.def -lef_file tech.lef

# 2. Define ESD Components
# Identify cell types for diodes and clamps based on library naming
set esd_diodes [get_cells -filter "ref_name =~ *ESD_DIODE*"]
set power_clamps [get_cells -filter "ref_name =~ *ESD_CLAMP*"]

# 3. Perform Placement Strategy Checks
# Check if any I/O bump is too far from its assigned clamp
perform esdcheck -rule placement_radius -radius 500 -clamp $power_clamps

# 4. Path Resistance Analysis (HBM/CDM)
# Calculate bump-to-clamp resistance for all signal pins
# This identifies if the placement is 'right' by confirming low-impedance paths
perform esdcheck -type path_resistance \
                 -from [get_ports *] \
                 -to $power_clamps \
                 -max_res 1.5 \
                 -report_file esd_path_res.rpt

# 5. Current Density Check
# Verify if the metal lines connecting the ESD cells can handle the zap current
run_esd_simulation -event HBM -voltage 2000 -output_dir ./sim_results

# 6. Report Violations
# Extract instances where the ESD strategy failed (missing connections or high resistance)
report_esd_violations -format text -out_file esd_violations.txt
