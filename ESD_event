#5nm design
# 1. Initialize 5nm Project with SeaScape Architecture
# PathFinder-SC handles 100M+ instances for ultra-large 5nm SoCs
set_project_node 5nm
import_design -def chip_top.def -lef tech_5nm.lef -lib foundry_esd_lib.lib

# 2. Define High-Speed I/O and ESD Clamps
# 5nm designs often use distributed clamps for high-speed SerDes pins
set ios [get_ports -filter "direction == inout"]
set clamps [get_cells -filter "ref_name =~ *ESD_CLAMP_5NM*"]

# 3. Connectivity & Placement Rule Check
# Checks if every bump has a valid discharge path to a power/ground rail
perform esdcheck -type connectivity -from $ios -to $clamps -report connectivity.rpt

# 4. 5nm-Specific P2P Resistance Analysis
# Critical for 5nm: Verifying path resistance to ensure it stays in the narrow <3V window
perform esdcheck -type path_resistance \
                 -from $ios \
                 -to $clamps \
                 -max_res 0.8 \
                 -net {VDD VSS} \
                 -report path_res_5nm.rpt

# 5. Current Density (CD) Simulation for HBM/CDM
# Checks if 5nm metal interconnects can handle the zap current without failure
run_esd_simulation -event HBM -voltage 2000 -out_dir ./hbm_results
run_esd_simulation -event CDM -voltage 500  -out_dir ./cdm_results

# 6. Analyze Results & Root Cause Detection
# Use the GUI to cross-probe high-resistance bottlenecks directly to the layout
report_esd_violations -out_file final_signoff.txt

